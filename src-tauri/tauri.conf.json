{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vexo",
  "version": "5.0.0",
  "identifier": "com.yuminoza.vexo",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "node copy-dist.js",
    "beforeBuildCommand": "node copy-dist.js"
  },
  "app": {
    "windows": [
      {
        "title": "Vexo — Your Personal Planner",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/Square150x150Logo.png",
      "icons/Square310x310Logo.png"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3ODNCMEJGQkVCREM1NEEKUldSS3hiMit2N0NEUjh6cGtqcjI2RGtscjd0SG1uWDVuenFGNXJ5bEVlMG0xWTFjS2M3WHFJaEoK",
      "endpoints": [
        "https://github.com/YumiNoona/Vexo/releases/latest/download/update-proxy.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
